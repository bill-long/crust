{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }, { "url": "tel:*" }, { "url": "xmpp:*" }, { "url": "geo:*" }, { "url": "magnet:*" }, { "url": "matrix:*" }] },
    "core:window:allow-start-dragging"
  ]
}
